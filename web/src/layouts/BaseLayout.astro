---
import "../styles/global.css";

interface Props {
	title?: string;
	authenticated?: boolean;
	fullHeight?: boolean;
}
const {
	title = "RTK-GNSS",
	authenticated = false,
	fullHeight = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#111827" />
		<title>{title}</title>
	</head>
	<body>
		<header class="border-b border-gray-200 bg-white">
			<div
				class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6"
			>
				<a href="/"
					><strong class="text-xl tracking-[.04em] sm:text-2xl">RTK-GNSS</strong
					></a
				>
				{
					authenticated && (
						<nav class="flex items-center gap-1 text-sm">
							<>
								<a class="nav-link" href="/">
									Live
								</a>
								<a class="nav-link" href="/history">
									History
								</a>
								<a class="nav-link" href="/system">
									System
								</a>
								<form id="logout-form" action="/api/auth/logout" method="post">
									<button id="logout" class="nav-link text-gray-500">
										<span id="logout-label">Log out</span>
									</button>
								</form>
							</>
						</nav>
					)
				}
			</div>
		</header>
		<main
			class:list={[
				"mx-auto max-w-7xl px-4 py-5 sm:px-6",
				fullHeight &&
					"full-height-main flex min-h-[calc(100svh-64px)] items-center justify-center",
			]}
		>
			<slot />
		</main>
		<script>
			const logoutForm =
				document.querySelector<HTMLFormElement>("#logout-form");
			const logout = document.querySelector<HTMLButtonElement>("#logout");
			const logoutLabel = document.querySelector("#logout-label");
			logoutForm?.addEventListener("submit", () => {
				if (logout) logout.disabled = true;
				if (logoutLabel) logoutLabel.textContent = "Logging out…";
			});
		</script>
	</body>
</html>
