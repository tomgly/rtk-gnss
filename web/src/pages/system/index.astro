---
import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LedReference from "../../components/LedReference.astro";
import { isAuthenticated } from "../../lib/auth";
const authenticated = await isAuthenticated(Astro);
const devices = await env.DB.prepare(
	"SELECT * FROM devices ORDER BY last_seen DESC",
).all<any>();
---

<BaseLayout title="System · RTK-GNSS" authenticated={authenticated}>
	<h1 class="mb-4 text-2xl font-semibold tracking-tight">System</h1>
	<section class="panel mb-4">
		<div class="px-4 py-3 section-title">Devices</div>
		<div class="table-wrap">
			<table class="mobile-stack-table">
				<thead
					><tr
						><th>Device</th><th>Gateway</th><th>Last seen</th><th
							>ESP-NOW RSSI</th
						><th>Wi-Fi RSSI</th><th>Protocol</th></tr
					></thead
				><tbody>
					{
						(devices.results ?? []).map((d: any) => (
							<tr>
								<>
									<td data-label="Device" class="font-medium">
										{d.device_id}
									</td>
									<td data-label="Gateway">{d.gateway_id ?? "—"}</td>
									<td data-label="Last seen" class="mono">
										{d.last_seen}
									</td>
									<td data-label="ESP-NOW RSSI" class="mono">
										{d.last_espnow_rssi ?? "—"}
									</td>
									<td data-label="Wi-Fi RSSI" class="mono">
										{d.last_wifi_rssi ?? "—"}
									</td>
									<td data-label="Protocol">{d.protocol_version ?? "—"}</td>
								</>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>
	<section class="panel p-4">
		<div class="section-title mb-4">LED reference</div><LedReference />
	</section>
</BaseLayout>
