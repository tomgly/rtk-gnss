---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { isAuthenticated } from "../lib/auth";

const authenticated = await isAuthenticated(Astro);
const db = env.DB;
const telemetry = await db
	.prepare(
		"SELECT * FROM telemetry WHERE record_id LIKE 'live:%' ORDER BY gateway_time DESC LIMIT 1",
	)
	.first<any>();
const gateway = await db
	.prepare(
		"SELECT * FROM devices WHERE device_id = gateway_id ORDER BY last_seen DESC LIMIT 1",
	)
	.first<any>();
const rover = await db
	.prepare(
		"SELECT * FROM devices WHERE device_id != gateway_id ORDER BY last_seen DESC LIMIT 1",
	)
	.first<any>();
const DEVICE_STATUS_MAX_AGE_MS = 15_000;
const TELEMETRY_MAX_AGE_MS = 120_000;
const isCurrentStatus = (status: any, maxAgeMs: number) => {
	const updatedAt = Date.parse(status?.gateway_time ?? "");
	return (
		Number.isFinite(updatedAt) &&
		updatedAt <= Date.now() &&
		Date.now() - updatedAt <= maxAgeMs
	);
};
const liveStatusCurrent = isCurrentStatus(telemetry, TELEMETRY_MAX_AGE_MS);
const hasCurrentGnssData = (status: any) =>
	isCurrentStatus(status, TELEMETRY_MAX_AGE_MS) &&
	Number(status?.fix) > 0 &&
	Number(status?.gnss_age_ms) <= 5_000;
const gatewayStatusCurrent = isCurrentStatus(
	{
		gateway_time: gateway?.last_seen,
	},
	DEVICE_STATUS_MAX_AGE_MS,
);
const roverStatusCurrent = isCurrentStatus(
	{
		gateway_time: rover?.last_seen,
	},
	DEVICE_STATUS_MAX_AGE_MS,
);
const roverLinkCurrent = roverStatusCurrent;
const currentTelemetry = liveStatusCurrent ? telemetry : null;
const currentPosition = hasCurrentGnssData(telemetry) ? telemetry : null;
const activeSession = await db
	.prepare(
		"SELECT * FROM sessions WHERE active=1 ORDER BY started_at DESC LIMIT 1",
	)
	.first<any>();

const fixLabel = (fix?: number) =>
	fix === 4
		? "RTK FIXED"
		: fix === 5
			? "RTK FLOAT"
			: fix === 2
				? "DIFFERENTIAL"
				: fix === 1
					? "SINGLE"
					: "NO FIX";
const fixState = (fix?: number) =>
	fix === 4
		? "fixed"
		: fix === 5
			? "float"
			: fix === 2
				? "differential"
				: fix === 1
					? "single"
					: "offline";
---

<BaseLayout
	title="Live · RTK-GNSS"
	description="Monitor RTK-GNSS Rover and Gateway status, GNSS fix quality, position, and field measurement sessions in real time."
	authenticated={authenticated}
>
	<div class="mb-4 flex items-center justify-between gap-3">
		<h1 class="text-2xl font-semibold tracking-tight">Live</h1>
		<div class="flex flex-wrap justify-end gap-2">
			<div
				id="gateway-state"
				class="status-badge"
				data-state={gatewayStatusCurrent ? "connected" : "offline"}
			>
				<span class="status-dot"></span><span id="gateway-state-label"
					>{gatewayStatusCurrent ? "Gateway Online" : "Gateway Offline"}</span
				>
			</div>
			<div
				id="rover-state"
				class="status-badge"
				data-state={roverLinkCurrent
					? currentTelemetry
						? "connected"
						: "no-data"
					: "offline"}
			>
				<span class="status-dot"></span><span id="rover-state-label"
					>{
						roverLinkCurrent
							? currentTelemetry
								? "Rover Online"
								: "Rover Online · No Data"
							: "Rover Offline"
					}</span
				>
			</div>
		</div>
	</div>

	<section
		id="gnss-status"
		class="status-hero mb-4"
		data-state={currentTelemetry
			? fixState(currentTelemetry.fix)
			: roverLinkCurrent
				? "no-data"
				: "offline"}
	>
		<div>
			<div class="section-title text-inherit opacity-75">GNSS solution</div>
			<div id="fix" class="mt-1 text-2xl font-semibold tracking-tight">
				{
					currentTelemetry
						? fixLabel(currentTelemetry.fix)
						: roverLinkCurrent
							? "No Data"
							: "No Signal"
				}
			</div>
		</div>
		<div class="status-hero-meta">
			<div>
				<span class="status-hero-label">Satellites</span><strong id="sats"
					>{currentTelemetry?.satellites ?? "—"}</strong
				>
			</div>
			<div>
				<span class="status-hero-label">HDOP</span><strong id="hdop"
					>{currentTelemetry?.hdop ?? "—"}</strong
				>
			</div>
		</div>
	</section>

	<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		<section class="status-card">
			<div class="section-title">Position</div>
			<div class="mt-3 grid gap-2">
				<div>
					<span class="metric-label">Latitude</span><strong
						id="lat"
						class="mono metric-value"
						>{currentPosition?.lat?.toFixed?.(7) ?? "—"}</strong
					>
				</div>
				<div>
					<span class="metric-label">Longitude</span><strong
						id="lon"
						class="mono metric-value"
						>{currentPosition?.lon?.toFixed?.(7) ?? "—"}</strong
					>
				</div>
			</div>
			<div class="mt-3 border-t border-gray-200 pt-3 text-sm text-gray-900">
				<span class="text-gray-500">Altitude</span>
				<strong class="mono"
					><span id="alt">{currentPosition?.alt_m?.toFixed?.(2) ?? "—"}</span> m</strong
				>
			</div>
		</section>

		<section class="status-card">
			<div class="section-title">Rover link</div>
			<div class="mt-3">
				<span class="metric-label">ESP-NOW RSSI</span><strong
					class="mono metric-value"
					><span id="esp-rssi"
						>{
							currentTelemetry?.espnow_rssi ?? rover?.last_espnow_rssi ?? "—"
						}</span
					> dBm</strong
				>
			</div>
			<div class="mt-3 border-t border-gray-200 pt-3 text-sm text-gray-900">
				<span class="text-gray-500">Packet loss </span>
				<strong id="lost" class="mono">
					{
						currentTelemetry
							? `${(
									(currentTelemetry.packets_lost /
										(currentTelemetry.packets_received +
											currentTelemetry.packets_lost)) *
									100
								).toFixed(1)}%`
							: "—"
					}
				</strong>
			</div>
		</section>

		<section class="status-card">
			<div class="section-title">Gateway</div>
			<div class="mt-3">
				<span class="metric-label">Wi-Fi RSSI</span><strong
					class="mono metric-value"
					><span id="wifi-rssi">{gateway?.last_wifi_rssi ?? "—"}</span> dBm</strong
				>
			</div>
			<div
				id="wifi-ssid"
				class="mt-3 truncate border-t border-gray-200 pt-3 text-sm font-medium text-gray-900"
			>
				{gatewayStatusCurrent ? "Online" : "Offline"}
			</div>
		</section>
	</div>

	<section class="panel mt-4 p-4">
		<div class="flex items-center justify-between gap-3">
			<div>
				<div class="section-title">Active session</div><div
					id="session-name"
					class="mt-1 font-semibold"
				>
					{activeSession?.name ?? "No active session"}
				</div>
			</div>
			<a
				href="/history"
				class="text-sm font-semibold text-blue-700 transition-colors hover:text-blue-900"
				>History →</a
			>
		</div>
		<div id="session-id" class="mono mt-2 truncate text-xs text-gray-500">
			{activeSession?.session_id ?? "Start a session from controls"}
		</div>
	</section>

	<details id="controls" class="control-drawer mt-4" open>
		<summary class="section-title">Measurement and session controls</summary>
		<div class="grid gap-4 border-t border-gray-200 p-4 lg:grid-cols-2">
			<section>
				<div class="section-title">Next measurement</div>
				{
					authenticated ? (
						<form id="arm-form" class="mt-3 flex flex-col gap-2 sm:flex-row">
							<input
								id="measurement-name"
								class="min-w-0 flex-1"
								maxlength="47"
								placeholder="Fence NW Corner"
								required
							/>
							<button class="btn control-action-button" type="submit">
								Arm Rover
							</button>
						</form>
					) : (
						<p class="mt-3 text-sm text-gray-600">
							Log in to arm a named measurement.
						</p>
					)
				}
				<p id="arm-state" class="mt-2 text-xs text-gray-500">Not armed</p>
			</section>
			<section>
				<div class="section-title">Session control</div>
				{
					authenticated ? (
						<>
							<div class="mt-3 flex flex-col gap-2 sm:flex-row">
								<input
									id="session-name-input"
									class="min-w-0 flex-1"
									placeholder="Farm field test"
								/>
								<button
									id="start-session"
									class="btn control-action-button"
									hidden={Boolean(activeSession)}
								>
									<span id="start-session-label">Start</span>
								</button>
								<button
									id="stop-session"
									class="btn btn-secondary control-action-button"
									hidden={!activeSession}
								>
									<span id="stop-session-label">Stop</span>
								</button>
							</div>
							<p id="session-state" class="mt-2 text-xs text-gray-500">
								{activeSession ? "Session active" : "No active session"}
							</p>
						</>
					) : (
						<p class="mt-3 text-sm text-gray-600">Log in required.</p>
					)
				}
			</section>
		</div>
	</details>

	<script is:inline define:vars={{ authenticated }}>
		document.documentElement.dataset.authenticated = String(authenticated);
	</script>
	<script src="../scripts/live.js"></script>
</BaseLayout>
