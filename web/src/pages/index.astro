---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import LedReference from "../components/LedReference.astro";
import { isAdmin } from "../lib/auth";

const admin = await isAdmin(Astro);
const db = env.DB;
const telemetry = await db.prepare("SELECT * FROM telemetry ORDER BY gateway_time DESC LIMIT 1").first<any>();
const measurements = await db.prepare("SELECT * FROM measurements ORDER BY gateway_time DESC LIMIT 8").all<any>();
const activeSession = await db.prepare("SELECT * FROM sessions WHERE active=1 ORDER BY started_at DESC LIMIT 1").first<any>();

const fixLabel = (fix?: number) => fix === 4 ? "RTK FIXED" : fix === 5 ? "RTK FLOAT" : fix === 2 ? "DIFFERENTIAL" : fix === 1 ? "SINGLE" : "NO FIX";
---
<BaseLayout title="Live · RTK-GNSS" admin={admin}>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <div class="section-title">Field console</div>
      <h1 class="mt-1 text-2xl font-semibold">Live</h1>
    </div>
    <div id="live-state" class="flex items-center gap-2 text-sm text-green-700"><span class="status-dot"></span> Live</div>
  </div>

  <section class="panel mb-4 grid divide-y divide-gray-200 md:grid-cols-4 md:divide-x md:divide-y-0">
    <div class="p-4"><div class="section-title">Session</div><div id="session-name" class="mt-2 font-semibold">{activeSession?.name ?? "No active session"}</div><div id="session-id" class="mono mt-1 truncate text-xs text-gray-500">{activeSession?.session_id ?? "—"}</div></div>
    <div class="p-4"><div class="section-title">GNSS</div><div id="fix" class="mt-2 text-lg font-semibold">{fixLabel(telemetry?.fix)}</div><div class="mt-1 text-sm text-gray-500"><span id="sats">{telemetry?.satellites ?? "—"}</span> sats · HDOP <span id="hdop">{telemetry?.hdop ?? "—"}</span></div></div>
    <div class="p-4"><div class="section-title">ESP-NOW</div><div class="mono mt-2 text-lg font-semibold"><span id="esp-rssi">{telemetry?.espnow_rssi ?? "—"}</span> dBm</div><div class="mt-1 text-sm text-gray-500">Lost <span id="lost">{telemetry?.packets_lost ?? "—"}</span></div></div>
    <div class="p-4"><div class="section-title">Gateway</div><div class="mt-2 text-lg font-semibold"><span id="wifi-rssi">{telemetry?.wifi_rssi ?? "—"}</span> dBm</div><div id="wifi-ssid" class="mt-1 truncate text-sm text-gray-500">{telemetry?.wifi_ssid ?? "Offline"}</div></div>
  </section>

  <div class="grid gap-4 lg:grid-cols-[1.35fr_.65fr]">
    <div class="space-y-4">
      <section class="panel p-4">
        <div class="section-title">Position</div>
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          <div><div class="text-xs text-gray-500">Latitude</div><div id="lat" class="mono mt-1 text-lg">{telemetry?.lat?.toFixed?.(9) ?? "—"}</div></div>
          <div><div class="text-xs text-gray-500">Longitude</div><div id="lon" class="mono mt-1 text-lg">{telemetry?.lon?.toFixed?.(9) ?? "—"}</div></div>
          <div><div class="text-xs text-gray-500">Altitude</div><div class="mono mt-1 text-lg"><span id="alt">{telemetry?.alt_m?.toFixed?.(3) ?? "—"}</span> m</div></div>
        </div>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 border-t border-gray-200 pt-3 text-sm text-gray-600">
          <span>Speed <b id="speed" class="mono font-medium text-gray-900">{telemetry?.speed_mps?.toFixed?.(2) ?? "—"}</b> m/s</span>
          <span>Course <b id="course" class="mono font-medium text-gray-900">{telemetry?.course_deg?.toFixed?.(1) ?? "—"}</b>°</span>
          <span>GNSS <b id="gnss-time" class="mono font-medium text-gray-900">{telemetry?.gnss_time ?? "—"}</b></span>
        </div>
      </section>

      <section class="panel p-4">
        <div class="flex items-center justify-between gap-3"><div class="section-title">Next measurement</div><span id="arm-state" class="text-xs text-gray-500">Not armed</span></div>
        {admin ? (
          <form id="arm-form" class="mt-3 flex gap-2">
            <input id="measurement-name" class="min-w-0 flex-1" maxlength="47" placeholder="Fence NW Corner" required />
            <button class="btn" type="submit">Arm Rover</button>
          </form>
        ) : (
          <p class="mt-3 text-sm text-gray-600">Sign in as admin to arm a named measurement.</p>
        )}
        <p class="mt-2 text-xs text-gray-500">When armed, the Rover LED turns blue. Press the physical button at the point to save it.</p>
      </section>

      <section class="panel">
        <div class="flex items-center justify-between px-4 py-3"><div class="section-title">Recent measurements</div><a href="/history" class="text-xs font-medium text-gray-600">View history →</a></div>
        <div class="table-wrap"><table><thead><tr><th>Time</th><th>Name</th><th>Fix</th><th>HDOP</th><th>RSSI</th></tr></thead><tbody id="measurements-body">
          {(measurements.results ?? []).map((m:any) => <tr class:list={[m.cancelled && "opacity-45 line-through"]}><td class="mono">{m.gateway_time?.slice(11,19)}</td><td>{m.name}</td><td>{fixLabel(m.fix)}</td><td class="mono">{m.hdop ?? "—"}</td><td class="mono">{m.espnow_rssi ?? "—"}</td></tr>)}
        </tbody></table></div>
      </section>
    </div>

    <aside class="space-y-4">
      <section class="panel p-4">
        <div class="section-title">Session control</div>
        {admin ? (
          <div class="mt-3 space-y-2">
            <input id="session-name-input" class="w-full" placeholder="Farm field test" />
            <div class="flex gap-2"><button id="start-session" class="btn flex-1">Start</button><button id="stop-session" class="btn btn-secondary flex-1">Stop</button></div>
          </div>
        ) : <p class="mt-3 text-sm text-gray-600">Admin sign-in required.</p>}
      </section>
      <section class="panel p-4">
        <div class="section-title">RTK / Network</div>
        <dl class="mt-3 grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-sm">
          <dt class="text-gray-500">NTRIP</dt><dd id="ntrip">{telemetry?.ntrip_enabled ? (telemetry?.ntrip_connected ? "Connected" : "Unavailable") : "Disabled"}</dd>
          <dt class="text-gray-500">RTCM age</dt><dd class="mono"><span id="rtcm-age">{telemetry?.rtcm_age_ms ?? "—"}</span> ms</dd>
          <dt class="text-gray-500">RTCM bytes</dt><dd id="rtcm-bytes" class="mono">{telemetry?.rtcm_bytes ?? "—"}</dd>
          <dt class="text-gray-500">Packets</dt><dd id="packets" class="mono">{telemetry?.packets_received ?? "—"}</dd>
        </dl>
      </section>
      <section class="panel p-4"><div class="section-title mb-4">LED reference</div><LedReference /></section>
    </aside>
  </div>

  <script is:inline define:vars={{ admin }}>
    const fixLabel = (fix) => fix === 4 ? "RTK FIXED" : fix === 5 ? "RTK FLOAT" : fix === 2 ? "DIFFERENTIAL" : fix === 1 ? "SINGLE" : "NO FIX";
    const txt = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value ?? "—"; };
    const num = (v, digits) => typeof v === "number" ? v.toFixed(digits) : "—";
    async function refresh() {
      try {
        const data = await fetch("/api/public/live", { cache: "no-store" }).then(r => r.json());
        const t = data.telemetry || {};
        txt("fix", fixLabel(t.fix)); txt("sats", t.satellites); txt("hdop", t.hdop); txt("esp-rssi", t.espnow_rssi); txt("lost", t.packets_lost);
        txt("wifi-rssi", t.wifi_rssi); txt("wifi-ssid", t.wifi_ssid || "Offline"); txt("lat", num(t.lat,9)); txt("lon", num(t.lon,9)); txt("alt", num(t.alt_m,3));
        txt("speed", num(t.speed_mps,2)); txt("course", num(t.course_deg,1)); txt("gnss-time", t.gnss_time); txt("packets", t.packets_received);
        txt("ntrip", t.ntrip_enabled ? (t.ntrip_connected ? "Connected" : "Unavailable") : "Disabled"); txt("rtcm-age", t.rtcm_age_ms); txt("rtcm-bytes", t.rtcm_bytes);
        txt("session-name", data.activeSession?.name || "No active session"); txt("session-id", data.activeSession?.session_id || "—");
      } catch { txt("live-state", "Offline"); }
    }
    setInterval(refresh, 2000);

    if (admin) {
      document.getElementById("arm-form")?.addEventListener("submit", async (e) => {
        e.preventDefault(); const input = document.getElementById("measurement-name"); const name = input?.value.trim(); if (!name) return;
        const r = await fetch("/api/measurement/arm", { method:"POST", headers:{"content-type":"application/json"}, body:JSON.stringify({name}) });
        if (r.ok) { txt("arm-state", `Armed: ${name}`); input.value = ""; }
      });
      document.getElementById("start-session")?.addEventListener("click", async () => {
        const name = document.getElementById("session-name-input")?.value.trim();
        const r = await fetch("/api/session", { method:"POST", headers:{"content-type":"application/json"}, body:JSON.stringify({action:"start", name}) });
        if (r.ok) refresh();
      });
      document.getElementById("stop-session")?.addEventListener("click", async () => {
        const r = await fetch("/api/session", { method:"POST", headers:{"content-type":"application/json"}, body:JSON.stringify({action:"stop"}) });
        if (r.ok) refresh();
      });
    }
  </script>
</BaseLayout>
